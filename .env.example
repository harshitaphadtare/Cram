# Copy this file to .env and fill in real values. Never commit .env.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase → Project Settings → Database → Connection string
# DATABASE_URL: Transaction pooler (port 6543) — used by the app at runtime.
# DIRECT_URL:   Session pooler or direct connection (port 5432) — used by Prisma migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# --- Signup alerts (optional; https://resend.com → API Keys) ---
# Emails SIGNUP_ALERT_TO with the name and country of each new user.
# Without a verified domain, Resend's test sender only delivers to your own Resend account's email.
RESEND_API_KEY=
SIGNUP_ALERT_TO=
# SIGNUP_ALERT_FROM="Cram <alerts@your-verified-domain.com>"
